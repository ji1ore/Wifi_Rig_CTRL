<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#1C1C1C"
    android:padding="6dp">

    <!-- Title + WPM -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="2dp">
        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="CW TX"
            android:textColor="#DDDDDD"
            android:textSize="15sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/tvCwWpmLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="20 WPM"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:minWidth="60dp"
            android:gravity="end" />
    </LinearLayout>

    <SeekBar
        android:id="@+id/seekCwWpm"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="55"
        android:progress="15"
        android:layout_marginBottom="2dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="* In CW mode, the rig&#39;s own WPM setting takes effect (this slider is ignored)"
        android:textColor="#666666"
        android:textSize="10sp"
        android:layout_marginBottom="4dp" />

    <!-- Switches -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="4dp">
        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="Swap L↔R"
            android:textColor="#888888"
            android:textSize="12sp" />
        <Switch
            android:id="@+id/switchPaddleSwap"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp" />
        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="PTT poll"
            android:textColor="#888888"
            android:textSize="12sp" />
        <Switch
            android:id="@+id/switchPttPoll"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <!-- NR level -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="4dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="NR:"
            android:textColor="#888888"
            android:textSize="12sp"
            android:layout_marginEnd="4dp" />
        <Button
            android:id="@+id/btnCwNrOff"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:text="OFF"
            android:textSize="11sp"
            android:backgroundTint="#333333"
            android:textColor="#888888"
            android:padding="0dp" />
        <Button
            android:id="@+id/btnCwNr1"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:text="1"
            android:textSize="11sp"
            android:backgroundTint="#333333"
            android:textColor="#888888"
            android:padding="0dp"
            android:layout_marginStart="2dp" />
        <Button
            android:id="@+id/btnCwNr2"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:text="2"
            android:textSize="11sp"
            android:backgroundTint="#333333"
            android:textColor="#888888"
            android:padding="0dp"
            android:layout_marginStart="2dp" />
        <Button
            android:id="@+id/btnCwNr3"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:text="3"
            android:textSize="11sp"
            android:backgroundTint="#333333"
            android:textColor="#888888"
            android:padding="0dp"
            android:layout_marginStart="2dp" />
        <Button
            android:id="@+id/btnCwNr4"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:text="4"
            android:textSize="11sp"
            android:backgroundTint="#333333"
            android:textColor="#888888"
            android:padding="0dp"
            android:layout_marginStart="2dp" />
        <Button
            android:id="@+id/btnCwNr5"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:text="5"
            android:textSize="11sp"
            android:backgroundTint="#333333"
            android:textColor="#888888"
            android:padding="0dp"
            android:layout_marginStart="2dp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#333333"
        android:layout_marginBottom="4dp" />

    <!-- Frequency display + step -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="2dp">
        <Button
            android:id="@+id/btnCwFreqDown"
            android:layout_width="44dp"
            android:layout_height="30dp"
            android:text="◀"
            android:textSize="14sp"
            android:backgroundTint="#333333"
            android:textColor="#AAAAAA"
            android:padding="0dp" />
        <TextView
            android:id="@+id/tvCwFreqDisplay"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="-.---00"
            android:textColor="#00E5FF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:background="#222222" />
        <Button
            android:id="@+id/btnCwFreqUp"
            android:layout_width="44dp"
            android:layout_height="30dp"
            android:text="▶"
            android:textSize="14sp"
            android:backgroundTint="#333333"
            android:textColor="#AAAAAA"
            android:padding="0dp" />
    </LinearLayout>

    <!-- CW decode RX -->
    <HorizontalScrollView
        android:id="@+id/hsvCwPanelRx"
        android:layout_width="match_parent"
        android:layout_height="20dp"
        android:scrollbars="none"
        android:layout_marginBottom="2dp">
        <TextView
            android:id="@+id/tvCwPanelRx"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="RX:"
            android:textColor="#76FF03"
            android:textSize="12sp"
            android:fontFamily="monospace" />
    </HorizontalScrollView>

    <!-- CW decode TX -->
    <HorizontalScrollView
        android:id="@+id/hsvCwPanelTx"
        android:layout_width="match_parent"
        android:layout_height="20dp"
        android:scrollbars="none"
        android:layout_marginBottom="4dp">
        <TextView
            android:id="@+id/tvCwPanelTx"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#4FC3F7"
            android:textSize="12sp"
            android:fontFamily="monospace" />
    </HorizontalScrollView>

    <!-- MY callsign -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="4dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MY: "
            android:textColor="#888888"
            android:textSize="12sp" />
        <TextView
            android:id="@+id/tvCwMyCall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="(not set)"
            android:textColor="#00E5FF"
            android:textSize="14sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="  ← Set in Connect screen"
            android:textColor="#555555"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- DX + RST -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="2dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DX:"
            android:textColor="#888888"
            android:textSize="12sp"
            android:layout_marginEnd="4dp" />
        <EditText
            android:id="@+id/etCwDxCall"
            android:layout_width="0dp"
            android:layout_weight="3"
            android:layout_height="40dp"
            android:hint="JA2ABC"
            android:textColor="#FFFFFF"
            android:textColorHint="#505050"
            android:backgroundTint="#333333"
            android:inputType="textVisiblePassword|textCapCharacters|textNoSuggestions"
            android:singleLine="true"
            android:padding="6dp"
            android:textSize="14sp" />
        <Button
            android:id="@+id/btnCwDxClear"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:text="×"
            android:textSize="13sp"
            android:backgroundTint="#444444"
            android:textColor="#AAAAAA"
            android:padding="0dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="6dp" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="RST:"
            android:textColor="#888888"
            android:textSize="12sp"
            android:layout_marginEnd="4dp" />
        <EditText
            android:id="@+id/etCwRst"
            android:layout_width="0dp"
            android:layout_weight="2"
            android:layout_height="40dp"
            android:hint="599"
            android:textColor="#FFFFFF"
            android:textColorHint="#505050"
            android:backgroundTint="#333333"
            android:inputType="textVisiblePassword|textCapCharacters|textNoSuggestions"
            android:singleLine="true"
            android:padding="6dp"
            android:textSize="14sp" />
        <Button
            android:id="@+id/btnCwRstClear"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:text="×"
            android:textSize="12sp"
            android:backgroundTint="#444444"
            android:textColor="#AAAAAA"
            android:padding="0dp"
            android:layout_marginStart="3dp" />
        <Button
            android:id="@+id/btnRst5NN"
            android:layout_width="40dp"
            android:layout_height="32dp"
            android:text="5NN"
            android:textSize="11sp"
            android:backgroundTint="#333333"
            android:textColor="#AAAAAA"
            android:padding="0dp"
            android:layout_marginStart="3dp" />
        <Button
            android:id="@+id/btnRstR1"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:text="1×"
            android:textSize="11sp"
            android:backgroundTint="#1A5C30"
            android:textColor="#FFFFFF"
            android:padding="0dp"
            android:layout_marginStart="4dp" />
        <Button
            android:id="@+id/btnRstR2"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:text="2×"
            android:textSize="11sp"
            android:backgroundTint="#333333"
            android:textColor="#888888"
            android:padding="0dp"
            android:layout_marginStart="2dp" />
        <Button
            android:id="@+id/btnRstR3"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:text="3×"
            android:textSize="11sp"
            android:backgroundTint="#333333"
            android:textColor="#888888"
            android:padding="0dp"
            android:layout_marginStart="2dp" />
    </LinearLayout>

    <!-- POTA + JCC -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="4dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="POTA:"
            android:textColor="#888888"
            android:textSize="12sp"
            android:layout_marginEnd="4dp" />
        <EditText
            android:id="@+id/etCwPota"
            android:layout_width="0dp"
            android:layout_weight="3"
            android:layout_height="40dp"
            android:hint="JP-XXXX"
            android:textColor="#FFFFFF"
            android:textColorHint="#505050"
            android:backgroundTint="#333333"
            android:inputType="textVisiblePassword|textCapCharacters|textNoSuggestions"
            android:singleLine="true"
            android:padding="6dp"
            android:textSize="14sp" />
        <Button
            android:id="@+id/btnCwPotaClear"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:text="×"
            android:textSize="12sp"
            android:backgroundTint="#444444"
            android:textColor="#AAAAAA"
            android:padding="0dp"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="6dp" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="JCC:"
            android:textColor="#888888"
            android:textSize="12sp"
            android:layout_marginEnd="4dp" />
        <EditText
            android:id="@+id/etCwJcc"
            android:layout_width="0dp"
            android:layout_weight="2"
            android:layout_height="40dp"
            android:hint="1234"
            android:textColor="#FFFFFF"
            android:textColorHint="#505050"
            android:backgroundTint="#333333"
            android:inputType="number"
            android:singleLine="true"
            android:padding="6dp"
            android:textSize="14sp" />
        <Button
            android:id="@+id/btnCwJccClear"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:text="×"
            android:textSize="12sp"
            android:backgroundTint="#444444"
            android:textColor="#AAAAAA"
            android:padding="0dp"
            android:layout_marginStart="3dp" />
    </LinearLayout>

    <!-- Tab bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="4dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:orientation="horizontal">
            <Button
                android:id="@+id/btnTabCq"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:text="CQ"
                android:textSize="14sp"
                android:textStyle="bold"
                android:backgroundTint="#222222"
                android:textColor="#FFFFFF" />
            <Button
                android:id="@+id/btnTabAns"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:text="ANS"
                android:textSize="14sp"
                android:textStyle="bold"
                android:backgroundTint="#222222"
                android:textColor="#666666" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:orientation="horizontal">
            <View
                android:id="@+id/viewTabIndCq"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:background="#4499FF" />
            <View
                android:id="@+id/viewTabIndAns"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:background="#333333" />
        </LinearLayout>
    </LinearLayout>

    <!-- ═══ CQ panel (fills remaining height) ═══ -->
    <LinearLayout
        android:id="@+id/panelCq"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Call× 1/2/3 + POTA + JCC toggles -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="2dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Call×"
                android:textColor="#888888"
                android:textSize="11sp"
                android:layout_marginEnd="4dp" />
            <Button
                android:id="@+id/btnCqR1"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:text="1"
                android:textSize="12sp"
                android:backgroundTint="#333333"
                android:textColor="#888888"
                android:padding="0dp" />
            <Button
                android:id="@+id/btnCqR2"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:text="2"
                android:textSize="12sp"
                android:backgroundTint="#333333"
                android:textColor="#888888"
                android:padding="0dp"
                android:layout_marginStart="2dp" />
            <Button
                android:id="@+id/btnCqR3"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:text="3"
                android:textSize="12sp"
                android:backgroundTint="#333333"
                android:textColor="#888888"
                android:padding="0dp"
                android:layout_marginStart="2dp" />
            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
            <Button
                android:id="@+id/btnCqTogPota"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="POTA"
                android:textSize="12sp"
                android:backgroundTint="#333333"
                android:textColor="#888888"
                android:padding="0dp"
                android:minWidth="48dp"
                android:layout_marginStart="8dp" />
            <Button
                android:id="@+id/btnCqTogJcc"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="JCC"
                android:textSize="12sp"
                android:backgroundTint="#333333"
                android:textColor="#888888"
                android:padding="0dp"
                android:minWidth="48dp"
                android:layout_marginStart="2dp" />
        </LinearLayout>

        <!-- CQ assembled button -->
        <Button
            android:id="@+id/btnCwCq"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:text="CQ CQ CQ DE ○○ K"
            android:textSize="14sp"
            android:backgroundTint="#1A3A5C"
            android:textColor="#DDDDDD"
            android:layout_marginBottom="2dp" />

        <!-- DX K | DX DE MY K -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:layout_marginBottom="2dp">
            <Button
                android:id="@+id/btnCwCqDxK"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:text="△△ K"
                android:textSize="14sp"
                android:backgroundTint="#1A3A5C"
                android:textColor="#DDDDDD"
                android:layout_marginEnd="2dp" />
            <Button
                android:id="@+id/btnCwCall"
                android:layout_width="0dp"
                android:layout_weight="2"
                android:layout_height="match_parent"
                android:text="△△ DE ○○"
                android:textSize="14sp"
                android:backgroundTint="#1A3A5C"
                android:textColor="#DDDDDD" />
        </LinearLayout>

        <!-- Greeting toggle -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="2dp">
            <Button
                android:id="@+id/btnCqGrNone"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:text="--"
                android:textSize="12sp"
                android:backgroundTint="#333333"
                android:textColor="#888888"
                android:padding="0dp" />
            <Button
                android:id="@+id/btnCqGrGm"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:text="GM"
                android:textSize="12sp"
                android:backgroundTint="#333333"
                android:textColor="#888888"
                android:padding="0dp"
                android:layout_marginStart="2dp" />
            <Button
                android:id="@+id/btnCqGrGe"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:text="GE"
                android:textSize="12sp"
                android:backgroundTint="#333333"
                android:textColor="#888888"
                android:padding="0dp"
                android:layout_marginStart="2dp" />
            <Button
                android:id="@+id/btnCqGrGa"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:text="GA"
                android:textSize="12sp"
                android:backgroundTint="#333333"
                android:textColor="#888888"
                android:padding="0dp"
                android:layout_marginStart="2dp" />
        </LinearLayout>

        <!-- QSL toggle -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="2dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="QSL"
                android:textColor="#888888"
                android:textSize="11sp"
                android:layout_marginEnd="4dp" />
            <Button
                android:id="@+id/btnCqQslNone"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:text="--"
                android:textSize="12sp"
                android:backgroundTint="#333333"
                android:textColor="#888888"
                android:padding="0dp" />
            <Button
                android:id="@+id/btnCqQslPse"
                android:layout_width="0dp"
                android:layout_weight="2"
                android:layout_height="match_parent"
                android:text="PSE QSL"
                android:textSize="12sp"
                android:backgroundTint="#333333"
                android:textColor="#888888"
                android:padding="0dp"
                android:layout_marginStart="2dp" />
            <Button
                android:id="@+id/btnCqQslNo"
                android:layout_width="0dp"
                android:layout_weight="2"
                android:layout_height="match_parent"
                android:text="NO QSL"
                android:textSize="12sp"
                android:backgroundTint="#333333"
                android:textColor="#888888"
                android:padding="0dp"
                android:layout_marginStart="2dp" />
        </LinearLayout>

        <!-- UR RST BK -->
        <Button
            android:id="@+id/btnCwCqUr"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:text="UR 599 BK"
            android:textSize="14sp"
            android:backgroundTint="#1A3A5C"
            android:textColor="#DDDDDD"
            android:layout_marginBottom="2dp" />

        <!-- TU 73 E E + AGN -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:layout_marginBottom="2dp">
            <Button
                android:id="@+id/btnCwCqTu"
                android:layout_width="0dp"
                android:layout_weight="2"
                android:layout_height="match_parent"
                android:text="TU 73 E E"
                android:textSize="14sp"
                android:backgroundTint="#1A3A5C"
                android:textColor="#DDDDDD"
                android:layout_marginEnd="4dp" />
            <Button
                android:id="@+id/btnCwCqAgn"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:text="AGN"
                android:textSize="14sp"
                android:backgroundTint="#1A3A5C"
                android:textColor="#DDDDDD"
                android:layout_marginStart="4dp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#333333"
            android:layout_marginBottom="2dp" />

        <!-- Count + Interval (combined row) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="2dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cnt"
                android:textColor="#888888"
                android:textSize="10sp"
                android:layout_marginEnd="2dp" />
            <Button
                android:id="@+id/btnCqLoop3"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:text="3×"
                android:textSize="11sp"
                android:backgroundTint="#333333"
                android:textColor="#888888"
                android:padding="0dp" />
            <Button
                android:id="@+id/btnCqLoop5"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:text="5×"
                android:textSize="11sp"
                android:backgroundTint="#333333"
                android:textColor="#888888"
                android:padding="0dp"
                android:layout_marginStart="2dp" />
            <Button
                android:id="@+id/btnCqLoop10"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:text="10×"
                android:textSize="11sp"
                android:backgroundTint="#333333"
                android:textColor="#888888"
                android:padding="0dp"
                android:layout_marginStart="2dp" />
            <Button
                android:id="@+id/btnCqLoopInf"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:text="∞"
                android:textSize="13sp"
                android:backgroundTint="#333333"
                android:textColor="#888888"
                android:padding="0dp"
                android:layout_marginStart="2dp" />
            <View android:layout_width="6dp" android:layout_height="match_parent" android:background="#444444" android:layout_marginStart="4dp" android:layout_marginEnd="4dp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Int"
                android:textColor="#888888"
                android:textSize="10sp"
                android:layout_marginEnd="2dp" />
            <Button
                android:id="@+id/btnCqInt10"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:text="10s"
                android:textSize="11sp"
                android:backgroundTint="#333333"
                android:textColor="#888888"
                android:padding="0dp" />
            <Button
                android:id="@+id/btnCqInt15"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:text="15s"
                android:textSize="11sp"
                android:backgroundTint="#333333"
                android:textColor="#888888"
                android:padding="0dp"
                android:layout_marginStart="2dp" />
            <Button
                android:id="@+id/btnCqInt30"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:text="30s"
                android:textSize="11sp"
                android:backgroundTint="#333333"
                android:textColor="#888888"
                android:padding="0dp"
                android:layout_marginStart="2dp" />
            <Button
                android:id="@+id/btnCqInt60"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:text="60s"
                android:textSize="11sp"
                android:backgroundTint="#333333"
                android:textColor="#888888"
                android:padding="0dp"
                android:layout_marginStart="2dp" />
        </LinearLayout>

        <!-- Repeat status + CQ REPEAT -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView
                android:id="@+id/tvCqRepeatStatus"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#AAAAAA"
                android:textSize="11sp"
                android:layout_marginEnd="6dp" />
            <Button
                android:id="@+id/btnCqRepeat"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="▶ CQ REPEAT"
                android:textSize="13sp"
                android:backgroundTint="#1A5C2A"
                android:textColor="#DDDDDD"
                android:minWidth="130dp" />
        </LinearLayout>

    </LinearLayout>

    <!-- ═══ ANS panel (fills remaining height, hidden initially) ═══ -->
    <LinearLayout
        android:id="@+id/panelAns"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- POTA + JCC toggles -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="2dp">
            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
            <Button
                android:id="@+id/btnAnsTogPota"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="POTA"
                android:textSize="12sp"
                android:backgroundTint="#333333"
                android:textColor="#888888"
                android:padding="0dp"
                android:minWidth="48dp" />
            <Button
                android:id="@+id/btnAnsTogJcc"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="JCC"
                android:textSize="12sp"
                android:backgroundTint="#333333"
                android:textColor="#888888"
                android:padding="0dp"
                android:minWidth="48dp"
                android:layout_marginStart="2dp" />
        </LinearLayout>

        <!-- MY K | DX DE MY K -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:layout_marginBottom="2dp">
            <Button
                android:id="@+id/btnCwAnsCall"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:text="○○ K"
                android:textSize="14sp"
                android:backgroundTint="#2A1A5C"
                android:textColor="#DDDDDD"
                android:layout_marginEnd="2dp" />
            <Button
                android:id="@+id/btnCwAnsDE"
                android:layout_width="0dp"
                android:layout_weight="2"
                android:layout_height="match_parent"
                android:text="△△ DE ○○"
                android:textSize="14sp"
                android:backgroundTint="#2A1A5C"
                android:textColor="#DDDDDD" />
        </LinearLayout>

        <!-- Greeting toggle -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="2dp">
            <Button
                android:id="@+id/btnAnsGrNone"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:text="--"
                android:textSize="12sp"
                android:backgroundTint="#333333"
                android:textColor="#888888"
                android:padding="0dp" />
            <Button
                android:id="@+id/btnAnsGrGm"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:text="GM"
                android:textSize="12sp"
                android:backgroundTint="#333333"
                android:textColor="#888888"
                android:padding="0dp"
                android:layout_marginStart="2dp" />
            <Button
                android:id="@+id/btnAnsGrGe"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:text="GE"
                android:textSize="12sp"
                android:backgroundTint="#333333"
                android:textColor="#888888"
                android:padding="0dp"
                android:layout_marginStart="2dp" />
            <Button
                android:id="@+id/btnAnsGrGa"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:text="GA"
                android:textSize="12sp"
                android:backgroundTint="#333333"
                android:textColor="#888888"
                android:padding="0dp"
                android:layout_marginStart="2dp" />
        </LinearLayout>

        <!-- QSL toggle -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="2dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="QSL"
                android:textColor="#888888"
                android:textSize="11sp"
                android:layout_marginEnd="4dp" />
            <Button
                android:id="@+id/btnQslNone"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:text="--"
                android:textSize="12sp"
                android:backgroundTint="#333333"
                android:textColor="#888888"
                android:padding="0dp" />
            <Button
                android:id="@+id/btnQslPse"
                android:layout_width="0dp"
                android:layout_weight="2"
                android:layout_height="match_parent"
                android:text="PSE QSL"
                android:textSize="12sp"
                android:backgroundTint="#333333"
                android:textColor="#888888"
                android:padding="0dp"
                android:layout_marginStart="2dp" />
            <Button
                android:id="@+id/btnQslTnx"
                android:layout_width="0dp"
                android:layout_weight="2"
                android:layout_height="match_parent"
                android:text="NO QSL"
                android:textSize="12sp"
                android:backgroundTint="#333333"
                android:textColor="#888888"
                android:padding="0dp"
                android:layout_marginStart="2dp" />
        </LinearLayout>

        <!-- UR RST BK -->
        <Button
            android:id="@+id/btnCwUr"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:text="UR 599 BK"
            android:textSize="14sp"
            android:backgroundTint="#2A1A5C"
            android:textColor="#DDDDDD"
            android:layout_marginBottom="2dp" />

        <!-- TU 73 DE MY E E + AGN -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:layout_marginBottom="2dp">
            <Button
                android:id="@+id/btnCwTu"
                android:layout_width="0dp"
                android:layout_weight="3"
                android:layout_height="match_parent"
                android:text="TU 73 DE ○○ E E"
                android:textSize="14sp"
                android:backgroundTint="#2A1A5C"
                android:textColor="#DDDDDD"
                android:layout_marginEnd="4dp" />
            <Button
                android:id="@+id/btnCwAgn"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:text="AGN"
                android:textSize="14sp"
                android:backgroundTint="#2A1A5C"
                android:textColor="#DDDDDD"
                android:layout_marginStart="4dp" />
        </LinearLayout>

    </LinearLayout>

    <!-- Free text + SEND -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="4dp">
        <EditText
            android:id="@+id/etCwFreeText"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="48dp"
            android:hint="Free text"
            android:textColor="#FFFFFF"
            android:textColorHint="#606060"
            android:backgroundTint="#444444"
            android:inputType="textVisiblePassword|textCapCharacters|textNoSuggestions"
            android:singleLine="true"
            android:padding="8dp"
            android:layout_marginEnd="6dp"
            android:textSize="14sp" />
        <Button
            android:id="@+id/btnCwSend"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="SEND"
            android:textSize="14sp"
            android:backgroundTint="#1A5C2A"
            android:textColor="#DDDDDD" />
    </LinearLayout>

    <!-- STOP button -->
    <Button
        android:id="@+id/btnCwSheetStop"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="■  STOP"
        android:textSize="15sp"
        android:backgroundTint="#7A1A1A"
        android:textColor="#FFFFFF"
        android:visibility="gone" />

</LinearLayout>
