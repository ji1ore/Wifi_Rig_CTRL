<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="#000000"
    android:padding="8dp">

    <!-- Left: display area -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingEnd="8dp">

        <!-- Model + TX -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="2dp">
            <TextView
                android:id="@+id/tvModel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:text="---" />
            <Button
                android:id="@+id/btnColorTheme"
                android:layout_width="60dp"
                android:layout_height="22dp"
                android:text="OCEAN"
                android:textSize="9sp"
                android:padding="0dp"
                android:backgroundTint="#1565C0"
                android:textColor="#FFFFFF"
                android:layout_marginEnd="4dp" />
            <TextView
                android:id="@+id/tvTxIndicator"
                android:layout_width="40dp"
                android:layout_height="24dp"
                android:gravity="center"
                android:text="TX"
                android:textSize="12sp"
                android:textColor="#000000"
                android:background="#DDDDDD" />
        </LinearLayout>

        <!-- Frequency display: auto-sizes to fill available height -->
        <LinearLayout
            android:id="@+id/llFreqPanel"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <Button
                android:id="@+id/btnFreqMinus"
                android:layout_width="40dp"
                android:layout_height="56dp"
                android:text="◀"
                android:textSize="14sp"
                android:backgroundTint="#1565C0"
                android:textColor="#FFFFFF"
                android:padding="0dp"
                android:minHeight="0dp"
                android:minWidth="0dp" />
            <TextView
                android:id="@+id/tvFreq"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="0.00000"
                android:textColor="#FFFFFF"
                android:textSize="48sp"
                app:autoSizeTextType="uniform"
                app:autoSizeMinTextSize="16sp"
                app:autoSizeMaxTextSize="64sp"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:clickable="true"
                android:focusable="true" />
            <Button
                android:id="@+id/btnFreqPlus"
                android:layout_width="40dp"
                android:layout_height="56dp"
                android:text="▶"
                android:textSize="14sp"
                android:backgroundTint="#1565C0"
                android:textColor="#FFFFFF"
                android:padding="0dp"
                android:minHeight="0dp"
                android:minWidth="0dp" />
        </LinearLayout>

        <!-- MHz label -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:text="MHz"
            android:textColor="#888888"
            android:textSize="12sp"
            android:paddingEnd="4dp" />

        <!-- S-meter card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#08081A"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:paddingTop="3dp"
            android:paddingBottom="2dp"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="3dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="16dp"
                    android:layout_height="wrap_content"
                    android:text="S"
                    android:textColor="#00C853"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:gravity="center"/>
                <LinearLayout
                    android:id="@+id/llSmeter"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"/>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/llSmeterLabels"
                android:layout_width="match_parent"
                android:layout_height="11dp"
                android:orientation="horizontal"
                android:paddingStart="16dp"/>
        </LinearLayout>

        <!-- Info row: Step / Width / Mode / Pow / SQL / BK-IN (tap to select for UP/DOWN) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:orientation="horizontal"
            android:layout_marginBottom="4dp">
            <TextView android:id="@+id/tvStep"  android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" android:textColor="#CCCCCC" android:textSize="10sp" android:gravity="center"
                android:clickable="true" android:focusable="true" android:background="?attr/selectableItemBackground"/>
            <TextView android:id="@+id/tvMode"  android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" android:textColor="#CCCCCC" android:textSize="11sp" android:gravity="center"
                android:clickable="true" android:focusable="true" android:background="?attr/selectableItemBackground"/>
            <TextView android:id="@+id/tvPow"   android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" android:textColor="#CCCCCC" android:textSize="11sp" android:gravity="center"
                android:clickable="true" android:focusable="true" android:background="?attr/selectableItemBackground"/>
            <TextView android:id="@+id/tvWidth" android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" android:textColor="#CCCCCC" android:textSize="10sp" android:gravity="center"
                android:clickable="true" android:focusable="true" android:background="?attr/selectableItemBackground"/>
            <TextView android:id="@+id/tvSQL"   android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" android:textColor="#CCCCCC" android:textSize="11sp" android:gravity="center"
                android:clickable="true" android:focusable="true" android:background="?attr/selectableItemBackground"/>
            <TextView android:id="@+id/tvBkIn"  android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" android:textColor="#666666" android:textSize="10sp" android:gravity="center"
                android:clickable="true" android:focusable="true" android:background="?attr/selectableItemBackground"/>
        </LinearLayout>

        <!-- Volume slider -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="2dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Vol"
                android:textColor="#888888"
                android:textSize="14sp"
                android:layout_marginEnd="6dp"/>
            <SeekBar
                android:id="@+id/seekVolume"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="100"
                android:progress="50" />
        </LinearLayout>

        <!-- Mic Gain slider -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mic"
                android:textColor="#888888"
                android:textSize="14sp"
                android:layout_marginEnd="6dp"/>
            <SeekBar
                android:id="@+id/seekMicGain"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="30"
                android:progress="10" />
            <TextView
                android:id="@+id/tvMicGain"
                android:layout_width="32dp"
                android:layout_height="wrap_content"
                android:text="1.0"
                android:textColor="#AAAAAA"
                android:textSize="12sp"
                android:gravity="end"
                android:layout_marginStart="4dp"/>
        </LinearLayout>

        <!-- CW/BT ステータスバー（一行） -->
        <LinearLayout
            android:id="@+id/llCwUsb"
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#111111"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:layout_marginTop="4dp"
            android:clickable="true"
            android:focusable="true">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CW:"
                android:textColor="#888888"
                android:textSize="12sp"
                android:layout_marginEnd="4dp"/>
            <!-- BT タップエリア - 左寄せ -->
            <LinearLayout
                android:id="@+id/llCwBt"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingEnd="6dp"
                android:clickable="true"
                android:focusable="true">
                <TextView
                    android:id="@+id/tvCwBtStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="BT"
                    android:textColor="#444444"
                    android:textSize="11sp"
                    android:textStyle="bold"/>
            </LinearLayout>
            <TextView
                android:id="@+id/tvCwUsbLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="USB"
                android:textColor="#444444"
                android:textSize="11sp"
                android:textStyle="bold"
                android:layout_marginEnd="4dp"/>
            <TextView
                android:id="@+id/tvCwUsbStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Not connected"
                android:textColor="#555555"
                android:textSize="12sp"/>
            <TextView
                android:id="@+id/tvCwServerStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Svr:--"
                android:textColor="#AAAAAA"
                android:textSize="11sp"
                android:layout_marginStart="6dp"/>
            <TextView
                android:id="@+id/tvCwUsbPort"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ttyACM0"
                android:textColor="#444444"
                android:textSize="11sp"/>
        </LinearLayout>

        <!-- CW デコード表示欄 (SPK長押しで表示/非表示) TX上段・RX下段 -->
        <LinearLayout
            android:id="@+id/llCwDecoder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:visibility="gone"
            android:background="#0D0D00"
            android:layout_marginTop="2dp"
            android:clickable="true"
            android:focusable="true">
            <!-- TX / RX ラベル列 -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TX:"
                    android:textColor="#00E5FF"
                    android:textSize="12sp"
                    android:fontFamily="monospace"/>
                <TextView
                    android:id="@+id/tvCwFreq0"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="RX:"
                    android:textColor="#FFFF00"
                    android:textSize="12sp"
                    android:fontFamily="monospace"/>
                <TextView
                    android:id="@+id/tvCwFreq1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="---"
                    android:textColor="#FFAA00"
                    android:textSize="12sp"
                    android:fontFamily="monospace"
                    android:visibility="gone"/>
                <TextView
                    android:id="@+id/tvCwFreq2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="---"
                    android:textColor="#FF8800"
                    android:textSize="12sp"
                    android:fontFamily="monospace"
                    android:visibility="gone"/>
                <TextView
                    android:id="@+id/tvCwFreq3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="---"
                    android:textColor="#FF6600"
                    android:textSize="12sp"
                    android:fontFamily="monospace"
                    android:visibility="gone"/>
                <TextView
                    android:id="@+id/tvCwFreq4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="---"
                    android:textColor="#FF4400"
                    android:textSize="12sp"
                    android:fontFamily="monospace"
                    android:visibility="gone"/>
            </LinearLayout>
            <!-- スクロールテキスト領域 (行ごとに独立スクロール) -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <HorizontalScrollView
                    android:id="@+id/hsvCwTx"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none"
                    android:overScrollMode="never">
                    <TextView
                        android:id="@+id/tvCwTx"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textColor="#00E5FF"
                        android:textSize="13sp"
                        android:fontFamily="monospace"
                        android:paddingEnd="8dp"/>
                </HorizontalScrollView>
                <HorizontalScrollView
                    android:id="@+id/hsvCwRx0"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none"
                    android:overScrollMode="never">
                    <TextView
                        android:id="@+id/tvCwRx0"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textColor="#FFFF00"
                        android:textSize="13sp"
                        android:fontFamily="monospace"
                        android:paddingEnd="8dp"/>
                </HorizontalScrollView>
                <HorizontalScrollView
                    android:id="@+id/hsvCwRx1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none"
                    android:overScrollMode="never"
                    android:visibility="gone">
                    <TextView
                        android:id="@+id/tvCwRx1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textColor="#FFAA00"
                        android:textSize="13sp"
                        android:fontFamily="monospace"
                        android:paddingEnd="8dp"/>
                </HorizontalScrollView>
                <HorizontalScrollView
                    android:id="@+id/hsvCwRx2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none"
                    android:overScrollMode="never"
                    android:visibility="gone">
                    <TextView
                        android:id="@+id/tvCwRx2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textColor="#FF8800"
                        android:textSize="13sp"
                        android:fontFamily="monospace"
                        android:paddingEnd="8dp"/>
                </HorizontalScrollView>
                <HorizontalScrollView
                    android:id="@+id/hsvCwRx3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none"
                    android:overScrollMode="never"
                    android:visibility="gone">
                    <TextView
                        android:id="@+id/tvCwRx3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textColor="#FF6600"
                        android:textSize="13sp"
                        android:fontFamily="monospace"
                        android:paddingEnd="8dp"/>
                </HorizontalScrollView>
                <HorizontalScrollView
                    android:id="@+id/hsvCwRx4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none"
                    android:overScrollMode="never"
                    android:visibility="gone">
                    <TextView
                        android:id="@+id/tvCwRx4"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textColor="#FF4400"
                        android:textSize="13sp"
                        android:fontFamily="monospace"
                        android:paddingEnd="8dp"/>
                </HorizontalScrollView>
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>

    <!-- Right: button grid 4x4 -->
    <GridLayout
        android:id="@+id/gridButtons"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:columnCount="4"
        android:rowCount="4"
        android:useDefaultMargins="true">

        <!-- Row 1: Mode quick select (LSB/USB toggle / CW↔CWR / AM / FM↔PKTFM) -->
        <Button android:id="@+id/btnModeLsb" android:text="LSB/USB" android:textSize="14sp" android:layout_columnWeight="1" android:layout_rowWeight="1" android:layout_width="0dp" android:layout_height="0dp" android:backgroundTint="#1A237E" android:textColor="#AAAAFF" android:padding="0dp"/>
        <Button android:id="@+id/btnModeUsb" android:text="CW"      android:textSize="14sp" android:layout_columnWeight="1" android:layout_rowWeight="1" android:layout_width="0dp" android:layout_height="0dp" android:backgroundTint="#1A237E" android:textColor="#AAAAFF" android:padding="0dp"/>
        <Button android:id="@+id/btnModeCw"  android:text="AM"      android:textSize="14sp" android:layout_columnWeight="1" android:layout_rowWeight="1" android:layout_width="0dp" android:layout_height="0dp" android:backgroundTint="#1A237E" android:textColor="#AAAAFF" android:padding="0dp"/>
        <Button android:id="@+id/btnModeFm"  android:text="FM"      android:textSize="14sp" android:layout_columnWeight="1" android:layout_rowWeight="1" android:layout_width="0dp" android:layout_height="0dp" android:backgroundTint="#1A237E" android:textColor="#AAAAFF" android:padding="0dp"/>

        <!-- Row 2: VFO / FREQ / PO/WD/SQ / MEM -->
        <Button android:id="@+id/btnVfoToggle"  android:text="A/B"      android:textSize="16sp" android:layout_columnWeight="1" android:layout_rowWeight="1" android:layout_width="0dp" android:layout_height="0dp" android:backgroundTint="#455A64" android:textColor="#AAAAAA" android:padding="0dp"/>
        <Button android:id="@+id/btnFreq"       android:text="FREQ"     android:textSize="14sp" android:layout_columnWeight="1" android:layout_rowWeight="1" android:layout_width="0dp" android:layout_height="0dp" android:backgroundTint="#1565C0" android:textColor="#FFFFFF" android:padding="0dp"/>
        <Button android:id="@+id/btnPowWidSql"  android:text="P/W/S"    android:textSize="13sp" android:layout_columnWeight="1" android:layout_rowWeight="1" android:layout_width="0dp" android:layout_height="0dp" android:backgroundTint="#1565C0" android:textColor="#FFFFFF" android:padding="0dp"/>
        <Button android:id="@+id/btnMem"        android:text="MEM"      android:textSize="14sp" android:layout_columnWeight="1" android:layout_rowWeight="1" android:layout_width="0dp" android:layout_height="0dp" android:backgroundTint="#37474F" android:textColor="#AAAAAA" android:padding="0dp"/>

        <!-- Row 3: CW TX / FT8 / APRS / PTT -->
        <Button android:id="@+id/btnCwTx"  android:text="CW TX" android:textSize="14sp" android:layout_columnWeight="1" android:layout_rowWeight="1" android:layout_width="0dp" android:layout_height="0dp" android:backgroundTint="#1A1A1A" android:textColor="#555555" android:padding="0dp"/>
        <Button android:id="@+id/btnFt8"   android:text="FT8"  android:textSize="16sp" android:layout_columnWeight="1" android:layout_rowWeight="1" android:layout_width="0dp" android:layout_height="0dp" android:backgroundTint="#006064" android:textColor="#FFFFFF" android:padding="0dp"/>
        <Button android:id="@+id/btnAprs"  android:text="APRS" android:textSize="16sp" android:layout_columnWeight="1" android:layout_rowWeight="1" android:layout_width="0dp" android:layout_height="0dp" android:backgroundTint="#455A64" android:textColor="#FFFFFF" android:padding="0dp"/>
        <Button android:id="@+id/btnPtt"   android:text="PTT"  android:textSize="16sp" android:layout_columnWeight="1" android:layout_rowWeight="1" android:layout_width="0dp" android:layout_height="0dp" android:backgroundTint="#6A1B9A" android:textColor="#FFFFFF" android:padding="0dp"/>

        <!-- Row 4: Back / SPK / DOWN / UP -->
        <Button android:id="@+id/btnBack"  android:text="Back" android:textSize="16sp" android:layout_columnWeight="1" android:layout_rowWeight="1" android:layout_width="0dp" android:layout_height="0dp" android:backgroundTint="#B71C1C" android:textColor="#FFFFFF" android:padding="0dp"/>
        <Button android:id="@+id/btnSpk"   android:text="SPK"  android:textSize="16sp" android:layout_columnWeight="1" android:layout_rowWeight="1" android:layout_width="0dp" android:layout_height="0dp" android:backgroundTint="#1B5E20" android:textColor="#FFFFFF" android:padding="0dp"/>
        <Button android:id="@+id/btnNr"   android:text="NR"  android:textSize="16sp" android:layout_columnWeight="1" android:layout_rowWeight="1" android:layout_width="0dp" android:layout_height="0dp" android:backgroundTint="#1565C0" android:textColor="#FFFFFF" android:padding="0dp"/>
        <Button android:id="@+id/btnDec"  android:text="DEC" android:textSize="16sp" android:layout_columnWeight="1" android:layout_rowWeight="1" android:layout_width="0dp" android:layout_height="0dp" android:backgroundTint="#1565C0" android:textColor="#FFFFFF" android:padding="0dp"/>

    </GridLayout>

</LinearLayout>
